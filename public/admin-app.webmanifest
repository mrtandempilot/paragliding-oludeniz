  "description": "Atmos Paragliding işletme paneli",
  "id": "/admin/app",
  "start_url": "/admin/app",
  "scope": "/admin/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0B1220",
  "theme_color": "#0B1220",
